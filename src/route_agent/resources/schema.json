{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "route-agent output",
  "type": "object",
  "required": [
    "request_id",
    "verdict",
    "confidence",
    "resolved_sequence",
    "resolved_annotations",
    "site_map",
    "route",
    "conflicts",
    "unknowns"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "feasible",
        "feasible_with_changes",
        "infeasible",
        "insufficient_information"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "resolved_sequence": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "site_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requested",
          "resolved",
          "residue",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "requested": {
            "type": "string"
          },
          "resolved": {
            "type": "string"
          },
          "residue": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "route": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "stage",
          "operation",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "stage": {
            "enum": [
              "resin_selection",
              "chain_assembly",
              "on_resin_modification",
              "n_terminal_cap",
              "cleavage",
              "solution_phase",
              "purification",
              "qc"
            ]
          },
          "operation": {
            "type": "string"
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/provenance"
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "kind",
          "description",
          "affected",
          "resolution",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor"
            ]
          },
          "kind": {
            "enum": [
              "protecting_group_orthogonality",
              "order_of_operations",
              "mutually_exclusive",
              "site_invalid",
              "reagent_incompatibility",
              "building_block_availability",
              "intent_not_achieved"
            ]
          },
          "description": {
            "type": "string"
          },
          "affected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/provenance"
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "corpus"
            },
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]+:[A-Za-z0-9_]+:[0-9]+$"
            }
          }
        },
        {
          "required": [
            "kind",
            "basis"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "inference"
            },
            "basis": {
              "type": "string"
            },
            "refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]+:[A-Za-z0-9_]+:[0-9]+$"
              }
            }
          }
        },
        {
          "required": [
            "kind",
            "source",
            "basis"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "external"
            },
            "source": {
              "type": "string"
            },
            "basis": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}