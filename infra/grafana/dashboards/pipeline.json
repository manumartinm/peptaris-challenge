        "y": 21
      },
      "id": 9,
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "route-agent-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n  timestamp,\n  run_id,\n  request_id,\n  event,\n  JSONExtractString(extra, 'process') AS process,\n  JSONExtractString(extra, 'family') AS family,\n  JSONExtractString(extra, 'site') AS site,\n  status,\n  JSONExtract(extra, 'passed', 'Nullable(String)') AS passed\nFROM route_agent_observability.logs\nWHERE event IN ('walk_start','walk_stage_start','walk_check_start','walk_check_done','walk_stage_done','walk_complete')\n  AND $__timeFilter(timestamp) AND (empty('${run_id:raw}') OR run_id = '${run_id:raw}') AND (empty('${request_id:raw}') OR request_id = '${request_id:raw}') AND (empty('${job_id:raw}') OR job_id = '${job_id:raw}')\nORDER BY timestamp DESC\nLIMIT 200"
        }
      ],
      "title": "Walk checks",
      "type": "table"
    }
