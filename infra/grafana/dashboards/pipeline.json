      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "route-agent-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n  stage,\n  countIf(JSONExtractString(extra, 'kind') = 'stage_started' OR event = 'pipeline_event_stage_started') AS started,\n  countIf(JSONExtractString(extra, 'kind') = 'stage_finished' OR event = 'pipeline_event_stage_finished') AS finished,\n  avg(duration_ms) AS avg_ms\nFROM route_agent_observability.logs\nWHERE stage IS NOT NULL AND $__timeFilter(timestamp) AND (empty('${run_id:raw}') OR run_id = '${run_id:raw}') AND (empty('${request_id:raw}') OR request_id = '${request_id:raw}') AND (empty('${job_id:raw}') OR job_id = '${job_id:raw}')\nGROUP BY stage\nORDER BY stage"
        }
      ],
      "title": "Stage activity",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "route-agent-clickhouse"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 8,
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "route-agent-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT event, count() AS n, avg(duration_ms) AS avg_ms, quantile(0.95)(duration_ms) AS p95_ms, max(duration_ms) AS max_ms FROM route_agent_observability.logs WHERE duration_ms IS NOT NULL AND $__timeFilter(timestamp) AND (empty('${run_id:raw}') OR run_id = '${run_id:raw}') AND (empty('${request_id:raw}') OR request_id = '${request_id:raw}') AND (empty('${job_id:raw}') OR job_id = '${job_id:raw}') GROUP BY event ORDER BY avg_ms DESC LIMIT 25"
        }
      ],
      "title": "Latency by event",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "route-agent-clickhouse"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {},
