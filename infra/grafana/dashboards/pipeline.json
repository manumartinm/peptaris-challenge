          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(empty(status), 'unknown', status) AS verdict, count() AS n FROM route_agent_observability.logs WHERE event = 'pipeline_complete' AND $__timeFilter(timestamp) AND (empty('${run_id:raw}') OR run_id = '${run_id:raw}') AND (empty('${request_id:raw}') OR request_id = '${request_id:raw}') AND (empty('${job_id:raw}') OR job_id = '${job_id:raw}') GROUP BY verdict ORDER BY n DESC"
        }
