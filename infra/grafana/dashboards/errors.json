          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n  timestamp,\n  level,\n  component,\n  event,\n  run_id,\n  request_id,\n  job_id,\n  status,\n  message,\n  JSONExtractString(extra, 'error_type') AS error_type,\n  JSONExtractString(extra, 'error') AS error\nFROM route_agent_observability.logs\nWHERE level IN ('ERROR','CRITICAL','WARNING') AND $__timeFilter(timestamp) AND (empty('${run_id:raw}') OR run_id = '${run_id:raw}') AND (empty('${request_id:raw}') OR request_id = '${request_id:raw}') AND (empty('${job_id:raw}') OR job_id = '${job_id:raw}')\nORDER BY timestamp DESC\nLIMIT 200"
        }
      ],
