# Agent model (LiteLLM). Pin model and keep temperature low.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ROUTE_AGENT_MODEL=anthropic/claude-sonnet-4-5

# Hosted API (Railway sets PORT). Local CLI still binds 127.0.0.1:8000.
# ROUTE_AGENT_API_HOST=127.0.0.1
# ROUTE_AGENT_API_PORT=8000
# Extra CORS origins. https://*.vercel.app is already allowed.
# ROUTE_AGENT_CORS_ORIGINS=https://your-app.vercel.app
# ROUTE_AGENT_REASONING_EFFORT=medium

# Langfuse tracing. Defaults match infra/ headless init (docker compose).
# Leave empty to disable tracing. Cloud: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-local-route-agent
LANGFUSE_SECRET_KEY=sk-lf-local-route-agent
LANGFUSE_HOST=http://localhost:3000

# Local logs for Vector -> ClickHouse -> Grafana. See infra/README.md.
ROUTE_AGENT_LOG_DIR=.observability/logs
ROUTE_AGENT_LOG_FORMAT=json
ROUTE_AGENT_VERBOSE=2
# Full prompts/responses in Langfuse and logs. Keep off outside local debug.
ROUTE_AGENT_TRACE_PAYLOADS=true

# Optional path overrides (packaged resources and XDG defaults are used otherwise).
# ROUTE_AGENT_ENV_FILE=/absolute/path/to/route-agent.env
# ROUTE_AGENT_CACHE_DIR=
# ROUTE_AGENT_DATA_DIR=
# ROUTE_AGENT_CONFIG_DIR=
# ROUTE_AGENT_RESEARCH_ROOT=research
# ROUTE_AGENT_EXTRACTED_FAMILIES=data/extracted_families.json
# ROUTE_AGENT_TARGETS=data/ApexChem_templates_and_targets.xlsx
# ROUTE_AGENT_FRAGMENTS=data/molecular_fragments.json
# ROUTE_AGENT_SCHEMA=data/schema.json
# ROUTE_AGENT_REQUEST_SCHEMA=data/request_schema.json
# ROUTE_AGENT_SCORE_PY=data/score.py

# Seconds before a hung check is marked timeout and the walk continues.
ROUTE_AGENT_CHECK_TIMEOUT=180
# Molecular validation: RDKit 2D. 3D is Boltz (env only; no CLI flag, no keyring).
BOLTZ_API_KEY=
# ROUTE_AGENT_BOLTZ_TIMEOUT=180
# ROUTE_AGENT_MOLECULAR_PH=7.4
# ROUTE_AGENT_MOLECULAR_CONFORMERS=20
# ROUTE_AGENT_MOLECULAR_SEED=17
# ROUTE_AGENT_MOLECULAR_TIMEOUT=60
# ROUTE_AGENT_MOLECULAR_MAX_HEAVY=500
# ROUTE_AGENT_MOLECULAR_SKIP_3D=false
# JOURNAL_ALLOWLIST=pubs.acs.org,onlinelibrary.wiley.com,pubs.rsc.org,nature.com,ncbi.nlm.nih.gov
